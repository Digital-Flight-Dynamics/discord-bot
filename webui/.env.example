# Local scripts reuse DATABASE_URL from ../.env. Uncomment this for a
# standalone checkout or to override the bot database connection.
# DATABASE_URL=postgresql://user:pass@host:5432/dfd_bot
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:4321/auth/discord/callback
SESSION_COOKIE_SECURE=false
HOST=0.0.0.0
PORT=4321

# Bot service URL on the private container network. Local development uses 127.0.0.1.
BOT_INTERNAL_API_URL=http://127.0.0.1:3000
# Usually inherited from ../.env; only set here when ATC uses a separate environment.
# ATC_INTERNAL_API_KEY=
