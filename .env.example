BOT_TOKEN=
DATABASE_URL=postgresql://user:pass@host:5432/dfd_bot
ATC_URL=http://localhost:4321

# Shared secret used by ATC to publish authenticated events to the bot.
# Generate a long random value in production and configure the same value on both services.
ATC_INTERNAL_API_KEY=

# Workspace constants file under src/config/ (no extension required)
# - "dev"         → src/config/dev.ts          (bun run dev sets this by default)
# - "dfd-discord" → src/config/dfd-discord.ts  (production default if unset outside dev)
# Copy the template for a personal workspace:
#   cp src/config/dev.example.ts src/config/dev.ts
CONSTANTS_FILE=dev

# Extra defense: destructive dev commands refuse to run when this is "production"
NODE_ENV=development

HEALTH_PORT=3000
INTERNAL_API_HOST=0.0.0.0
