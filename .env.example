BOT_TOKEN=
DATABASE_URL=postgresql://user:pass@host:5432/dfd_bot
ATC_URL=https://atc.example.com

# Workspace constants file under src/config/ (no extension required)
# - "dev"         → src/config/dev.ts          (npm/bun run dev sets this by default)
# - "dfd-discord" → src/config/dfd-discord.ts  (production default if unset outside dev)
# Copy the template for a personal workspace:
#   cp src/config/dev.example.ts src/config/dev.ts
CONSTANTS_FILE=dev

# Enables dev-only commands (e.g. .devchannels) in addition to CONSTANTS_FILE=dev
NODE_ENV=development

# Optional: primary guild id (expiry worker fallback)
GUILD_ID=
HEALTH_PORT=3000
