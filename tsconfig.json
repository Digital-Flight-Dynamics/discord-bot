{
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "lib": ["ES2020"],
        "target": "ES2019",
        "module": "commonjs",
        "outDir": "out",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "experimentalDecorators": false,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": false
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "out"]
}
