{
    "name": "dfd-discord-bot",
    "version": "1.0.0",
    "scripts": {
        "build": "tsc",
        "dev": "CONSTANTS_FILE=dev nodemon --watch src/ -e ts --exec ts-node src/index.ts",
        "start": "node out/index.js",
        "lint": "eslint --cache **/*.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "ts-node scripts/run-migrate.ts",
        "db:push": "drizzle-kit push"
    },
    "author": "Digital Flight Dynamics",
    "license": "AGPL-3.0",
    "engines": {
        "node": "22.x",
        "npm": "10.x"
    },
    "dependencies": {
        "axios": "^1.18.1",
        "chrono-node": "^2.10.1",
        "discord.js": "^14.27.0",
        "dotenv": "^10.0.0",
        "drizzle-orm": "^0.45.2",
        "pg": "^8.22.0"
    },
    "devDependencies": {
        "@types/node": "^17.0.6",
        "@types/pg": "^8.20.0",
        "@typescript-eslint/eslint-plugin": "^5.6.0",
        "@typescript-eslint/parser": "^5.6.0",
        "drizzle-kit": "^0.31.10",
        "eslint": "^8.4.1",
        "nodemon": "^2.0.15",
        "ts-node": "^10.4.0",
        "typescript": "^5.9.3"
    }
}
