{
    "name": "dfd-discord-bot",
    "version": "1.0.0",
    "scripts": {
        "build": "tsc",
        "dev": "nodemon --watch src/ -e ts --exec ts-node src/index.ts",
        "start": "node out/index.js",
        "lint": "eslint \"src/**/*.ts\"",
        "lint:fix": "eslint \"src/**/*.ts\" --fix",
        "format": "prettier --write \"src/**/*.{ts,js,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
        "markdown:lint": "markdownlint --config .markdownlintrc.json \"**/*.md\" --ignore node_modules",
        "markdown:fix": "markdownlint --config .markdownlintrc.json \"**/*.md\" --ignore node_modules --fix",
        "check:all": "npm run lint && npm run format:check && npm run markdown:lint",
        "prepare": "husky install"
    },
    "author": "Digital Flight Dynamics",
    "license": "AGPL-3.0",
    "engines": {
        "node": "18.x",
        "npm": "8.x"
    },
    "dependencies": {
        "axios": "^0.24.0",
        "discord.js": "14.11.0",
        "dotenv": "^10.0.0",
        "mongoose": "^8.2.2"
    },
    "devDependencies": {
        "@types/node": "^17.0.6",
        "@typescript-eslint/eslint-plugin": "^5.6.0",
        "@typescript-eslint/parser": "^5.6.0",
        "eslint": "^8.4.1",
        "eslint-config-prettier": "^9.1.2",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.2",
        "markdownlint-cli": "^0.39.0",
        "nodemon": "^2.0.15",
        "prettier": "^3.8.1",
        "ts-node": "^10.4.0",
        "typescript": "^4.5.2"
    },
    "lint-staged": {
        "*.ts": [
            "eslint --max-warnings=0 --fix"
        ],
        "*.{ts,js,json}": [
            "prettier --check"
        ],
        "*.md": [
            "markdownlint --config .markdownlintrc.json"
        ]
    }
}
