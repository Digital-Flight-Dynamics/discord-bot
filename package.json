{
    "name": "dfd-discord-bot",
    "version": "1.0.0",
    "packageManager": "bun@1.3.12",
    "scripts": {
        "build": "tsc",
        "dev": "bun --watch src/index.ts",
        "start": "bun src/index.ts",
        "check": "biome check .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "lint": "biome lint .",
        "lint:md": "markdownlint-cli2 \"**/*.md\"",
        "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
        "prepare": "husky || true"
    },
    "lint-staged": {
        "*.{js,cjs,mjs,ts,cts,mts,json}": "biome check --write --no-errors-on-unmatched",
        "*.md": "markdownlint-cli2 --fix"
    },
    "overrides": {
        "@discordjs/builders": "1.7.0",
        "discord-api-types": "0.37.61"
    },
    "author": "Digital Flight Dynamics",
    "license": "AGPL-3.0",
    "engines": {
        "bun": ">=1.3.12"
    },
    "dependencies": {
        "axios": "^0.24.0",
        "discord.js": "14.11.0",
        "dotenv": "^10.0.0",
        "mongoose": "^8.2.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.2.4",
        "@types/node": "^17.0.6",
        "husky": "^9.1.7",
        "lint-staged": "15.5.2",
        "markdownlint-cli2": "0.17.2",
        "nodemon": "^2.0.15",
        "ts-node": "^10.4.0",
        "typescript": "^4.5.2"
    }
}
