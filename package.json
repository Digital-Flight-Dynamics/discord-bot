{
  "name": "dfd-discord-bot",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc",
    "dev": "bun scripts/dev-all.ts",
    "start": "bun out/src/index.js",
    "lint": "eslint --cache **/*.ts",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/run-migrate.ts",
    "db:push": "drizzle-kit push",
    "check": "bun run build && bun run lint && bun test"
  },
  "author": "Digital Flight Dynamics",
  "license": "AGPL-3.0",
  "engines": {
    "bun": ">=1.3.12"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "chrono-node": "^2.10.1",
    "discord.js": "^14.27.0",
    "dotenv": "^10.0.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "typescript": "^5.9.3"
  }
}
