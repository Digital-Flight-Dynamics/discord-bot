{
    "name": "dfd-discord-bot",
    "version": "1.0.0",
    "scripts": {
        "build": "tsc",
        "dev": "nodemon --watch src/ -e ts --exec ts-node src/index.ts",
        "start": "node out/index.js",
        "check": "biome check .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "lint": "biome lint .",
        "lint:md": "markdownlint-cli2 \"**/*.md\"",
        "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\"",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,cjs,mjs,ts,cts,mts,json}": "biome check --write --no-errors-on-unmatched",
        "*.md": "markdownlint-cli2 --fix"
    },
    "author": "Digital Flight Dynamics",
    "license": "AGPL-3.0",
    "engines": {
        "node": "18.x",
        "npm": "8.x"
    },
    "dependencies": {
        "axios": "^0.24.0",
        "discord.js": "14.11.0",
        "dotenv": "^10.0.0",
        "mongoose": "^8.2.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.2.4",
        "@types/node": "^17.0.6",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.6",
        "markdownlint-cli2": "^0.18.1",
        "nodemon": "^2.0.15",
        "ts-node": "^10.4.0",
        "typescript": "^4.5.2"
    }
}
