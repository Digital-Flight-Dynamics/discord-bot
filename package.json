{
  "name": "dfd-discord-bot",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc",
    "dev": "CONSTANTS_FILE=dev bun --watch src/index.ts",
    "start": "bun out/index.js",
    "lint": "eslint --cache **/*.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/run-migrate.ts",
    "db:push": "drizzle-kit push",
    "check": "bun run build && bun run lint"
  },
  "author": "Digital Flight Dynamics",
  "license": "AGPL-3.0",
  "engines": {
    "bun": ">=1.3.12"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "chrono-node": "^2.10.1",
    "discord.js": "^14.27.0",
    "dotenv": "^10.0.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8.57.1",
    "mongodb": "^7.5.0",
    "typescript": "^5.9.3"
  }
}
